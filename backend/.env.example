# ── 服务 ─────────────────────────────────────────
PORT=3000
CORS_ORIGIN=
JWT_SECRET=liujing-dev-secret-please-change-in-prod
JWT_EXPIRES_IN=7d

# ── 数据库 ───────────────────────────────────────
# sqlite: 本地零依赖直跑（默认） ｜ mysql: MySQL 8（答辩/部署用）
DB_DRIVER=sqlite
DB_FILE=./data/liujing.db

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=liujing
DB_POOL=10

# ── 月见大模型（按账号在设置页配置各自的 Key，本文件不承载任何 Key）──
# DeepSeek: https://api.deepseek.com/v1  ｜ 阿里百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL / LLM_MODEL 仅作为用户保存 Key 时的推荐默认值
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=25000

# ── 业务参数 ─────────────────────────────────────
DURATION_TOLERANCE=60
